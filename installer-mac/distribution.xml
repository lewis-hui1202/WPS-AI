<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>文小舟</title>
    <organization>com.lingxi-ai</organization>

    <!-- 安装向导界面文案 -->
    <welcome    file="welcome.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- 系统要求: macOS 10.15+ (Catalina,内置 zsh,LaunchAgent API 完整) -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.15"/>
        </allowed-os-versions>
    </volume-check>

    <!-- 装到系统盘(默认),非每用户 -->
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="x86_64,arm64"/>

    <!-- 选项: 单一选项,默认选中,不可取消 -->
    <choices-outline>
        <line choice="default">
            <line choice="com.lingxi-ai.installer"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.lingxi-ai.installer" visible="false">
        <pkg-ref id="com.lingxi-ai.installer"/>
    </choice>
    <pkg-ref id="com.lingxi-ai.installer" version="0" onConclusion="none">lingxi-ai-component.pkg</pkg-ref>
</installer-gui-script>
