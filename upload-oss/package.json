{
  "name": "lingxi-ai-upload-oss",
  "version": "1.0.0",
  "private": true,
  "description": "把文小舟 安装包上传到阿里云 OSS，并同步更新下载站的链接",
  "bin": {
    "lingxi-upload": "./index.js"
  },
  "scripts": {
    "build:win": "node lib/build-installer.js win",
    "build:mac": "node lib/build-installer.js mac",
    "build:linux": "node lib/build-installer.js linux",
    "build:linux:arm64": "node lib/build-installer.js linux --arch arm64",
    "build:linux:docker": "node lib/build-installer.js linux --docker",
    "build:linux:docker:arm64": "node lib/build-installer.js linux --docker --arch arm64",
    "upload": "node index.js",
    "upload:dry": "node index.js --dry-run",
    "upload:site": "node index.js --only-site-manifest",
    "upload:site:dry": "node index.js --only-site-manifest --dry-run",
    "upload:no-site": "node index.js --no-site-update",
    "upsite": "node lib/upload-site.js",
    "upsite:build": "node lib/upload-site.js --build",
    "upsite:clean": "node lib/upload-site.js --build --clean",
    "upsite:dry": "node lib/upload-site.js --dry-run"
  },
  "dependencies": {
    "ali-oss": "^6.21.0"
  },
  "engines": {
    "node": ">=16"
  }
}
